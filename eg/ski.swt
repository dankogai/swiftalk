// SKI combinator calculus — three birds are enough for everything.
// Curried, as the calculus demands; swiftalk's single Function type
// makes S's x(z)(y(z)) — call results called again — unremarkable.
//
// Run: swift run swiftalk eg/ski.swt

let I = { x in x }
let K = { x in { y in x } }
let S = { x in { y in { z in x(z)(y(z)) } } }

// I is derivable: S K K x = K(x)(K(x)) = x
print(S(K)(K)(42))                       // 42
print(S(K)(S)(42))                       // 42 — the middle bird never matters

// booleans: T = K, F = K I
let T = K
let F = K(I)
let IF = { c in { t in { f in c(t)(f) } } }
print(IF(T)("yes")("no"))                // yes
print(IF(F)("yes")("no"))                // no

// composition: B = S (K S) K — apply after apply
let B = S(K(S))(K)
print(B({ x in x * 2 })({ x in x + 1 })(20))   // 42: double after increment

// the iota bird: the WHOLE calculus from one combinator
//   ι = λf. f S K   —   I = ιι, K = ι(ι(ιι)), S = ι(ι(ι(ιι)))
let iota = { f in f(S)(K) }
let I2 = iota(iota)
let K2 = iota(iota(iota(iota)))
let S2 = iota(iota(iota(iota(iota))))
print(I2(42))                            // 42
print(K2(1)(2))                          // 1
print(S2(K)(K)(42))                      // 42
